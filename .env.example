# PostgreSQL
POSTGRES_DB=retail_intelligence
POSTGRES_USER=retail
POSTGRES_PASSWORD=retail_dev_password

# Backend
APP_ENV=development
DEBUG=true
# Must be at least 32 characters or the app refuses to start.
SECRET_KEY=change-this-in-production-to-a-long-random-value
DATABASE_URL=postgresql+psycopg://retail:retail_dev_password@db:5432/retail_intelligence
# Origins the browser loads the frontend from: 3000 = docker frontend, 4000 = `bun run dev`.
CORS_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:5173
OPENAI_API_KEY=
API_KEY=retailmind-dev-api-key

# Frontend
# Every backend route lives under /api/v1, and this URL is resolved by the browser —
# so use the host-published backend address, not the "backend" compose hostname.
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Must match the backend's API_KEY above whenever that gate is enabled.
VITE_API_KEY=retailmind-dev-api-key
VITE_USE_MOCKS=false
